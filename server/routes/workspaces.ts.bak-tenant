import { Router, type Request, type Response, type NextFunction } from "express";
import { timingSafeEqual } from "node:crypto";
import { z } from "zod";
import { pool } from "../db.js";
import { config } from "../config.js";

const router = Router({ mergeParams: true });

const updateSchema = z.object({
  expectedVersion: z.number().int().positive(),
  state: z.record(z.string(), z.unknown())
}).strict();

function requireAuth(req: Request, res: Response, next: NextFunction) {
  if (!req.session.userId) {
    return res.status(401).json({ error: "Authentication required" });
  }
  next();
}

function requireCsrf(req: Request, res: Response, next: NextFunction) {
  const origin = req.get("origin");

  if (origin && origin !== config.APP_ORIGIN) {
    return res.status(403).json({ error: "Request origin not allowed" });
  }

  const supplied = req.get("x-csrf-token");
  const expected = req.session.csrfToken;

  if (!supplied || !expected) {
    return res.status(403).json({ error: "Missing or invalid CSRF token" });
  }

  const a = Buffer.from(supplied);
  const b = Buffer.from(expected);

  if (a.length !== b.length || !timingSafeEqual(a, b)) {
    return res.status(403).json({ error: "Missing or invalid CSRF token" });
  }

  next();
}

async function findAccessibleWorkspace(organizationId: string, userId: string) {
  return pool.query(
    `SELECT w.id, w.organization_id, w.state_json, w.version, w.updated_at
     FROM workspaces w
     JOIN organization_members om
       ON om.organization_id = w.organization_id
     WHERE w.organization_id = $1
       AND om.user_id = $2
       AND om.status = 'active'
     LIMIT 1`,
    [organizationId, userId]
  );
}

router.get("/", requireAuth, async (req, res) => {
  const rawOrganizationId = req.params.organizationId;
  const organizationId =
    typeof rawOrganizationId === "string" ? rawOrganizationId : undefined;

  if (!organizationId) {
    return res.status(400).json({ error: "Organization ID is required" });
  }

  const result = await findAccessibleWorkspace(organizationId, req.session.userId!);

  if (result.rows.length === 0) {
    return res.status(404).json({ error: "Workspace not found" });
  }

  return res.json({ workspace: result.rows[0] });
});

router.put("/", requireAuth, requireCsrf, async (req, res) => {
  const rawOrganizationId = req.params.organizationId;
  const organizationId =
    typeof rawOrganizationId === "string" ? rawOrganizationId : undefined;

  if (!organizationId) {
    return res.status(400).json({ error: "Organization ID is required" });
  }

  const parsed = updateSchema.safeParse(req.body);

  if (!parsed.success) {
    return res.status(400).json({
      error: "Invalid workspace update.",
      details: parsed.error.issues.map((issue) => ({
        field: issue.path.join("."),
        message: issue.message
      }))
    });
  }

  const result = await pool.query(
    `UPDATE workspaces w
     SET state_json = $1::jsonb,
         version = version + 1,
         updated_by = $2,
         updated_at = NOW()
     WHERE w.organization_id = $3
       AND w.version = $4
       AND EXISTS (
         SELECT 1
         FROM organization_members om
         WHERE om.organization_id = w.organization_id
           AND om.user_id = $2
           AND om.status = 'active'
       )
     RETURNING w.id, w.organization_id, w.state_json, w.version, w.updated_at`,
    [
      JSON.stringify(parsed.data.state),
      req.session.userId,
      organizationId,
      parsed.data.expectedVersion
    ]
  );

  if (result.rows.length > 0) {
    return res.json({ workspace: result.rows[0] });
  }

  const current = await findAccessibleWorkspace(
    organizationId,
    req.session.userId!
  );

  if (current.rows.length === 0) {
    return res.status(404).json({ error: "Workspace not found" });
  }

  return res.status(409).json({
    error: "Workspace has changed. Fetch the latest version before retrying.",
    currentVersion: current.rows[0].version
  });
});

export default router;