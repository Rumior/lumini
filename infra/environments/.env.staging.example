# Environment Configuration
# Staging

NODE_ENV=staging
API_URL=https://staging-api.lumini.app
DATABASE_URL=${DATABASE_URL}
REDIS_URL=${REDIS_URL}
LOG_LEVEL=info

# Security
SESSION_SECRET=${SESSION_SECRET}
JWT_SECRET=${JWT_SECRET}

# Features
ENABLE_EXTERNAL_RESEARCH=true
ENABLE_AI_FEATURES=true
MOCK_DATA=false
